{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensions": {
    "durableTask": {
      "hubName": "PenanciaWorkflowHub",
      "storageProvider": {
        "type": "azureStorage"
      }
    },
    "queues": {
      "messageEncoding": "none",
      "maxDequeueCount": 5
    }
  }
}
