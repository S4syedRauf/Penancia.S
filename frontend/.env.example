# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Backend Configuration ---

# VITE_API_BASE: Base URL for the .NET API backend.
# Leave empty (default) to use same-origin (Express server on port 3000).
# Set to your .NET backend URL when deploying to Azure, e.g.:
# VITE_API_BASE="https://ca-penancias-api.politebush-2ba657a9.uaenorth.azurecontainerapps.io"
VITE_API_BASE=""

# VITE_BACKEND_ENABLED: Set to "true" to route sample uploads through the .NET
# Durable Functions backend (Azure Blob Storage + orchestrator).
# Default is "false" — uses the Express server pipeline (/v1/semen/analyze).
VITE_BACKEND_ENABLED="false"
